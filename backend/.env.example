# ==============================================================================
# Backend Environment Configuration (Render / Production)
# ==============================================================================

# Port dynamically injected by Render ($PORT) or local fallback
PORT=8000

# Environment mode: 'production' | 'development'
ENVIRONMENT=production

# Frontend origin allowed by CORS (Vercel deployment URL)
FRONTEND_URL=https://kamlesh-lovewanshi-portfolio.vercel.app

# Optional LLM API Keys (Server-side only — never exposed to client)
# If left blank, the API operates in zero-cost Demo Mode with high-fidelity sample evaluations
OPENAI_API_KEY=
GEMINI_API_KEY=
